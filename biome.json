{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": ["**", "!dist", "!coverage", "!node_modules", "!playwright-report", "!test-results"]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "three": "src/core/ is renderer-free: it must not import three.js."
                },
                "patterns": [
                  {
                    "group": ["three/**"],
                    "message": "src/core/ is renderer-free: it must not import three.js."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "src/core/ runs in Node: no window.",
                  "document": "src/core/ runs in Node: no document.",
                  "performance": "src/core/ never reads the clock: take dt as a parameter.",
                  "Date": "src/core/ never reads the clock: take dt as a parameter."
                }
              }
            }
          }
        }
      }
    }
  ]
}
