# EditorConfig - https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,jsx,ts,tsx}]
indent_size = 2
max_line_length = 100

[*.{html,css}]
indent_size = 2

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.md]
indent_size = 4
max_line_length = 80
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
