{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agh/ringfall/docs/frontmatter.schema.json",
  "title": "Ringfall document frontmatter",
  "description": "The crefft frontmatter contract (guides/docs/specifications.md, Machine-Readable Frontmatter) with the `type` enum extended for the document kinds this repository keeps under docs/. Applied by scripts/check-frontmatter.mjs to every Markdown file under docs/. The root README.md carries no frontmatter because GitHub renders it as a table above the banner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "type", "status", "authors", "created"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "rfc",
        "adr",
        "design-doc",
        "prd",
        "spec",
        "art-direction",
        "checklist",
        "decision-index",
        "glossary",
        "prfaq",
        "readme",
        "research",
        "risk-register",
        "runbook",
        "storyboard"
      ]
    },
    "status": { "enum": ["draft", "review", "approved", "superseded"] },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" }
        }
      }
    },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "supersedes": { "type": "string" },
    "related": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
